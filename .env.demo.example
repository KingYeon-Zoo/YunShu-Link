# 方舟大模型（必填）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHARACTER_MODEL=doubao-seed-character-260628
DOUBAO_SLM_MODEL=doubao-seed-2-0-lite-260428

# 豆包语音识别 2.0（必填，来自豆包语音控制台）
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# 豆包语音合成 2.0（优先使用新版控制台 API Key）
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_yingyujiaoxue_uranus_bigtts

# 如果使用旧版豆包语音控制台，可不用 DOUBAO_TTS_API_KEY，改填下面两项
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=

# 演示账号（可选）
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo@123456

# 数据库与 Docker Compose 项目名（通常无需修改）
DEMO_DB_NAME=xiaozhi_esp32_server
DEMO_DB_USER=root
DEMO_DB_PASSWORD=123456
DEMO_COMPOSE_PROJECT=yunshu-link-dev
